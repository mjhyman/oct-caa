%% Plot the Bayesian posterior AND raw stage-minus-control differences
%{
For each stain x region x measurement source (EPVS / vessel), the stage k
minus stage 0 (control) difference at each distance was computed two ways:

  Method 1 (model): difference of the Bayesian posterior fitted distance
                    curves -> "*_model_diff.csv"
                    (distance, diff_mean, diff_sd, lower, upper, n_draws)

  Method 2 (raw):   difference of the raw per-distance means
                    -> "*_raw_diff.csv"
                    (distance, mean_0, mean_k, diff, sd_0, sd_k,
                     n_0, n_k, se_diff)

This script reads BOTH and, for each stain x region x nonzero stage,
overlays the EPVS and vessel differences as ribbon plots:
  - model plots use diff_mean +/- 1 posterior SD (diff_sd)
  - raw   plots use diff      +/- 1 propagated SE (se_diff)
Figures are saved with distinct suffixes for each method.
%}

%% Top-level settings
clear; clc; close all;
% Input directory (root that contains the timestamped results folder)
beta_dir = '/projectnb/npbssmic/ns/CAA/histology/stats/';
% Results folder (timestamped) + analysis subfolder
summary_stats = 'bayesian_stats_histo_2026-06-30_13-17-53/stage_vs_control/';
input_filename = 'histogram_matched_donuts_2026-May-05';
% Directory to store figures
fig_out = '/projectnb/npbssmic/ns/CAA/figures/histology_scatterplots/stage_vs_control/';
fig_out = fullfile(fig_out, summary_stats);
if ~exist(fig_out, "dir")
    mkdir(fig_out)
end
% Save output
save_flag = true;

%% Iteration cells
% Nonzero stages only (stage 0 is the control reference -> no difference)
stages    = {'stage1','stage2','stage3'};
stage_k   = [1 2 3];
stage_lab = {'Mild','Moderate','Severe'};

stains      = {'lhe','gfap','cd68'};
stain_title = {'LHE','GFAP','CD68'};

regs      = {'front','occip'};
reg_title = {'Frontal','Occipital'};

% Measurement sources: EPVS goes in the "experimental" slot, vessel in the
% "control" slot of histo_mean_std_plot (matching the Groups convention).
srcs = {'epvs','vessel'};

% Methods to plot: struct field, file suffix, mean column, spread column,
% figure-suffix, and a short label used in the title.
methods = struct( ...
    'name',   {'model',            'raw'}, ...
    'file',   {'model_diff',       'raw_diff'}, ...
    'mucol',  {'diff_mean',        'diff'}, ...
    'sdcol',  {'diff_sd',          'se_diff'}, ...
    'suffix', {'model_diff',       'raw_diff'}, ...
    'lab',    {'model \pm1 SD',    'raw \pmSE'} ...
);

%% Import both methods from their CSVs
% ss.(method).(stage).(stain).(region).(src) = struct with fields d, mu, sd
ss = struct();
for m = 1:numel(methods)
    for ii = 1:numel(stages)
        kk = stage_k(ii);
        for j = 1:numel(stains)
            for k = 1:numel(regs)
                for s = 1:numel(srcs)
                    fname = sprintf('%s__%s_%s_%s_stage%d_vs_stage0_%s.csv', ...
                                    input_filename, stains{j}, regs{k}, ...
                                    srcs{s}, kk, methods(m).file);
                    fullpath = fullfile(beta_dir, summary_stats, ...
                                        regs{k}, srcs{s}, fname);
                    try
                        tmp = readtable(fullpath);
                    catch
                        fprintf('\tSkipping [%s] %s %s %s %s\n', ...
                                methods(m).name, stages{ii}, regs{k}, ...
                                stains{j}, srcs{s});
                        continue
                    end
                    ss.(methods(m).name).(stages{ii}).(stains{j}).(regs{k}).(srcs{s}).d  = tmp.distance;
                    ss.(methods(m).name).(stages{ii}).(stains{j}).(regs{k}).(srcs{s}).mu = tmp.(methods(m).mucol);
                    ss.(methods(m).name).(stages{ii}).(stains{j}).(regs{k}).(srcs{s}).sd = tmp.(methods(m).sdcol);
                end
            end
        end
    end
end

%% Scatterplots with ribbon
dot_size = 100;
lw       = 4;
fsize    = 30;
% Manually set y-axis limits and ticks for each stain (LHE, GFAP, CD68)
ylims    = [-0.5, 0.5; -0.5, 0.5; -0.5, 0.5];
yticks = {[-0.5:0.1:0.5],[-1.2:0]}


%%% Optional: auto y-limits over both methods / sources / stages / regions, per stain
% ylims = zeros(numel(stains), 2);
% for j = 1:numel(stains)
%     min_val = inf; max_val = -inf;
%     for m = 1:numel(methods)
%         for ii = 1:numel(stages)
%             for k = 1:numel(regs)
%                 for s = 1:numel(srcs)
%                     try
%                         S = ss.(methods(m).name).(stages{ii}).(stains{j}).(regs{k}).(srcs{s});
%                     catch
%                         continue
%                     end
%                     local_min = min(S.mu - S.sd, [], 'all');
%                     local_max = max(S.mu + S.sd, [], 'all');
%                     if local_min < min_val, min_val = local_min; end
%                     if local_max > max_val, max_val = local_max; end
%                 end
%             end
%         end
%     end
%     range_val = max_val - min_val;
%     ylims(j, :) = [min_val - 0.05*range_val, max_val + 0.05*range_val];
% end

%%% Programmatically set symmetric y-axis ticks centered on 0 (per stain)
% Define how many ticks you roughly want on either side of 0
% ticks_per_side = 3;
% ytick = {};
% for i = 1:size(ylims, 1)
%     current_lim = ylims(i, :);
%     % 1. Find the maximum absolute distance from 0 to ensure coverage
%     max_dist = max(abs(current_lim));
% 
%     % 2. Calculate a clean step size based on that maximum distance
%     step = max_dist / ticks_per_side;
% 
%     % 3. Generate symmetric ticks centered at 0
%     %    This goes from -max_dist to +max_dist, guaranteed to hit 0
%     raw_ticks = -max_dist : step : max_dist;
% 
%     % 4. Filter ticks so they only show up inside your actual limits
%     ticks = raw_ticks(raw_ticks >= current_lim(1) & raw_ticks <= current_lim(2));
% 
%     % Ensure 0 is exactly 0 (avoids tiny floating-point issues like -1e-16)
%     [~, zero_idx] = min(abs(ticks));
%     ticks(zero_idx) = 0;
%     % Add to array
%     ytick{i} = ticks;
% end

%%% Overlay EPVS vs vessel difference, once per method
% Iterate methods (model, raw)
for m = 1:numel(methods)
    % Iterate stages
    for ii = 1:numel(stages)
        % Iterate stains
        for j = 1:numel(stains)
            % Iterate regions
            for k = 1:numel(regs)
                % Need both sources to overlay
                try
                    E = ss.(methods(m).name).(stages{ii}).(stains{j}).(regs{k}).epvs;
                    V = ss.(methods(m).name).(stages{ii}).(stains{j}).(regs{k}).vessel;
                catch
                    continue
                end

                % Align on the distances common to both sources
                [cd, ie, iv] = intersect(E.d, V.d);
                if isempty(cd), continue; end
                cd      = cd(:);
                epvs_mu = E.mu(ie); epvs_mu = epvs_mu(:);
                epvs_sd = E.sd(ie); epvs_sd = epvs_sd(:);
                ves_mu  = V.mu(iv); ves_mu  = ves_mu(:);
                ves_sd  = V.sd(iv); ves_sd  = ves_sd(:);

                % Ribbon scatter plot (EPVS = experimental slot, vessel = control slot)
                figure;
                tstr = sprintf('%s %s %s: stage - control (%s)', ...
                               stage_lab{ii}, stain_title{j}, reg_title{k}, ...
                               methods(m).lab);
                histo_mean_std_plot(cd, epvs_mu, epvs_sd, ves_mu, ves_sd, ...
                                    ylims(j, :),ytick{j}, tstr)

                % Figure properties
                set(gca, 'fontsize', fsize)
                set(get(gca, 'Title'), 'FontSize', 10);
                set(gca, 'fontname', 'Arial');
                set(gca, 'XColor', 'k', 'YColor', 'k');
                set(gca, 'TickLength', [0.04, 0.04]);
                set(gca, 'YTick', ytick{j});     % symmetric ticks centered on 0
                pause(1)

                % Save as .pdf .png .fig with method-specific suffix
                if save_flag
                    fname = fullfile(fig_out, ...
                                     sprintf('%s_%s_%s_stage_minus_control_%s', ...
                                             stages{ii}, stains{j}, regs{k}, ...
                                             methods(m).suffix));
                    saveas(gcf, fname, 'png');
                    saveas(gcf, fname, 'fig');
                    exportgraphics(gcf,strcat(fname,'.svg'),'Resolution',600);
                end
            end
        end
    end
end