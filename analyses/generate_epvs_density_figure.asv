%% Export to tif
function export_tif(vol,fname,dir_out)
% EXPORT_TIF save a single volume as a TIF
% INPUTS
%   vol (single 3D array): heatmap
%   fname (string): name of file
%   dir_out (string): output directory

% Example 3D single precision array (e.g., 100x100 pixels x 10 frames)
imgStack = single(rand(100, 100, 10));

filename = 'output_single_precision.tif';

% Write the first slice/frame
imwrite(imgStack(:,:,1), filename, 'tif', 'Compression', 'none');

% Append remaining slices/frames
for k = 2:size(imgStack, 3)
    imwrite(imgStack(:,:,k), filename, 'tif', 'WriteMode', 'append', ...
            'Compression', 'none');
end


end