%% Create .TIF overlay of EPVS density with mask

%% Add top-level directory of code repository to path
clc; close all;
% Print current working directory
mydir  = pwd;
% Find indices of slashes separating directories
if ispc
    idcs = strfind(mydir,'\');
elseif isunix
    idcs = strfind(mydir,'/');
end
% Remove the two sub folders to reach parent
% (psoct_human_brain\vasculature\vesSegment)
topdir = mydir(1:idcs(end));
addpath(genpath(topdir));
% Set maximum number of threads equal to number of threads for script
ncores = feature('numcores');
maxNumCompThreads(ncores);
% Flag for loading CAA structs (false if already in environment)
flag_load_caa_structs = true;
% Directory for loading seg, mus, ret, mask, epvs
data_dir = '/projectnb/npbssmic/s/mhyman/CAA_data/matlab_structs/';
% Directory for heatmaps
heat_dir = '/projectnb/npbssmic/s/mhyman/CAA_data/heatmaps';

%% Load the structs
%{
% CAA 17
fprintf('Loading CAA17\n')
caa17 = load(fullfile(data_dir,'caa17.mat'));
caa17 = caa17.caa17;
fprintf('Finished Loading CAA17\n')
% CAA 22
fprintf('Loading CAA22\n')
caa22 = load(fullfile(data_dir,'caa22.mat'));
caa22 = caa22.caa22;
fprintf('Finished Loading CAA22\n')
% CAA 25
fprintf('Loading CAA25\n')
caa25 = load(fullfile(data_dir,'caa25.mat'));
caa25 = caa25.caa25;
fprintf('Finished Loading CAA25\n')
% CAA 26
fprintf('Loading CAA26\n')
caa26 = load(fullfile(data_dir,'caa26.mat'));
caa26 = caa26.caa26;
fprintf('Finished Loading CAA26\n')
%}

%% Load the EPVS density heatmaps

epvs = struct();

% CAA17 Occip
tmp = load(fullfile(heat_dir,'/caa17/occip/caa17_occip_interpolated_heatmap.mat'));
fields = fieldnames(tmp);
tmp = tmp.(fields{1});
epvs.caa17o = tmp;

% CAA 22 Front
tmp = load(fullfile(heat_dir,'/caa22/front/caa22_front_interpolated_heatmap.mat'));
fields = fieldnames(tmp);
tmp = tmp.(fields{1});
epvs.caa22f = tmp;

% CAA 22 Occip
tmp = load(fullfile(heat_dir,'/caa22/occip/caa22_occip_interpolated_heatmap.mat'));
fields = fieldnames(tmp);
tmp = tmp.(fields{1});
epvs.caa22o = tmp;

% CAA 25 Front
tmp = load(fullfile(heat_dir,'/caa25/front/caa25_front_interpolated_heatmap.mat'));
fields = fieldnames(tmp);
tmp = tmp.(fields{1});
epvs.caa25f = tmp;

% CAA 25 Occip
tmp = load(fullfile(heat_dir,'/caa25/occip/caa25_occip_interpolated_heatmap.mat'));
fields = fieldnames(tmp);
tmp = tmp.(fields{1});
epvs.caa25o = tmp;

% CAA 26 Occip
tmp = load(fullfile(heat_dir,'/caa26/occip/caa26_occip_interpolated_heatmap.mat'));
fields = fieldnames(tmp);
tmp = tmp.(fields{1});
epvs.caa26o = tmp;

%% Export EPVS density heatmap .TIF

% CAA17 Occip
tmp = single(epvs.caa17o);


% CAA 22 Front
tmp = single(epvs.caa22f);

