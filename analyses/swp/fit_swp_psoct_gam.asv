function results = fit_swp_psoct_gam(T, varargin)
% FIT_PSOCT_GAM  Fit GAMs for scattering coefficient and retardance as
%                functions of vessel SWP and EPVS SWP using MATLAB's
%                fitrgam (Statistics & Machine Learning Toolbox, R2021a+).
%
% USAGE
%   results = fit_psoct_gam(T)
%   results = fit_psoct_gam(T, 'NumKnots', 15, 'PlotResults', false)
%
% REQUIRED INPUT
%   T : table with columns:
%         'scattering'  - scattering coefficient (voxel-level)
%         'retardance'  - optical retardance      (voxel-level)
%         'ves_swp'         - vessel size-weighted proximity
%         'epvs_swp'    - EPVS size-weighted proximity
%
% OPTIONAL NAME-VALUE PAIRS
%   'NumKnots'      Number of knots for each spline term        (default: 10)
%   'SplineOrder'   Order of spline (3 = cubic)                 (default: 3)
%   'NumGridPts'    Points in marginal prediction grid          (default: 200)
%   'MaxSample'     Max voxels used for fitting (subsampling)   (default: 1e5)
%   'PlotResults'   Show smooth effect plots                    (default: true)
%   'Verbose'       Print model summaries to command window     (default: true)
%
% OUTPUT  results struct with fields:
%   .gam_scatter        - fitted GAM object for scattering
%   .gam_retard         - fitted GAM object for retardance
%   .grid_swp           - z-scored SWP grid used for marginal predictions
%   .grid_epvs          - z-scored EPVS_SWP grid used for marginal predictions
%   .pred_scatter_swp   - scattering predictions along SWP gradient
%   .pred_scatter_epvs  - scattering predictions along EPVS_SWP gradient
%   .pred_retard_swp    - retardance predictions along SWP gradient
%   .pred_retard_epvs   - retardance predictions along EPVS_SWP gradient
%   .T_fit              - (possibly subsampled) table used for fitting
%   .norm_params        - struct with mu/sigma used for z-scoring
%
% NOTES
%   * fitrgam fits each smooth term independently (additive model).
%   * NumKnots and SplineOrder are applied identically to both predictors;
%     fitrgam does not support per-predictor knot vectors directly.
%   * Marginal predictions hold the other predictor at its median (z-scored).
%   * For interaction effects, refit manually using 'Interactions', true.
%
% EXAMPLE
%   T = table(randn(1e4,1), randn(1e4,1), rand(1e4,1)*5, rand(1e4,1)*3, ...
%       'VariableNames', {'scattering','retardance','ves_swp','epvs_swp'});
%   results = fit_psoct_gam(T, 'NumKnots', 8, 'MaxSample', 5000);

    % ---------------------------------------------------------------------
    % 1. Parse and validate inputs
    % ---------------------------------------------------------------------
    p = inputParser();
    p.FunctionName = 'fit_psoct_gam';

    addRequired(p,  'T',            @(x) istable(x));
    addParameter(p, 'NumKnots',     10,   @(x) isnumeric(x) && isscalar(x) && x > 2);
    addParameter(p, 'SplineOrder',  3,    @(x) isnumeric(x) && isscalar(x) && x >= 2);
    addParameter(p, 'NumGridPts',   200,  @(x) isnumeric(x) && isscalar(x) && x > 1);
    addParameter(p, 'MaxSample',    1e5,  @(x) isnumeric(x) && isscalar(x) && x > 0);
    addParameter(p, 'PlotResults',  true, @islogical);
    addParameter(p, 'Verbose',      true, @islogical);

    parse(p, T, varargin{:});
    opts = p.Results;

    required_cols = {'scattering', 'retardance', 'ves_swp', 'epvs_swp'};
    missing = required_cols(~ismember(required_cols, T.Properties.VariableNames));
    if ~isempty(missing)
        error('fit_psoct_gam:missingColumns', ...
              'Table is missing required column(s): %s', strjoin(missing, ', '));
    end

    % Check for non-numeric or all-NaN columns
    for c = required_cols
        col = T.(c{1});
        if ~isnumeric(col)
            error('fit_psoct_gam:nonNumeric', 'Column "%s" must be numeric.', c{1});
        end
        if all(isnan(col))
            error('fit_psoct_gam:allNaN', 'Column "%s" is all NaN.', c{1});
        end
    end

    % Check toolbox availability
    if ~license('test', 'Statistics_Toolbox')
        error('fit_psoct_gam:noToolbox', ...
              'Statistics and Machine Learning Toolbox is required for fitrgam.');
    end

    % ---------------------------------------------------------------------
    % 2. Remove rows with any NaN/Inf in required columns
    % ---------------------------------------------------------------------
    T_work = T(:, required_cols);
    bad_rows = any(ismissing(T_work), 2) | ...
               any(isinf(table2array(T_work)), 2);
    n_removed = sum(bad_rows);
    T_work(bad_rows, :) = [];

    if opts.Verbose && n_removed > 0
        fprintf('[fit_psoct_gam] Removed %d rows with NaN/Inf values.\n', n_removed);
    end

    if height(T_work) < 2 * opts.NumKnots
        error('fit_psoct_gam:insufficientData', ...
              'Too few valid rows (%d) for %d knots. Reduce NumKnots or check data.', ...
              height(T_work), opts.NumKnots);
    end

    % ---------------------------------------------------------------------
    % 3. Subsample if necessary (stratified by SWP quantile)
    % ---------------------------------------------------------------------
    N = height(T_work);
    if N > opts.MaxSample
        if opts.Verbose
            fprintf('[fit_psoct_gam] Subsampling %d -> %d voxels (stratified by EPVS SWP).\n', ...
                    N, round(opts.MaxSample));
        end
        n_strata   = 10;
        edges      = quantile(T_work.epvs_swp, linspace(0, 1, n_strata + 1));
        edges(1)   = -Inf;
        edges(end) = Inf;
        n_per      = floor(opts.MaxSample / n_strata);
        keep_idx   = [];
        for s = 1:n_strata
            in_stratum = find(T_work.epvs_swp > edges(s) & T_work.epvs_swp <= edges(s+1));
            if isempty(in_stratum), continue; end
            n_draw   = min(n_per, numel(in_stratum));
            selected = in_stratum(randperm(numel(in_stratum), n_draw));
            keep_idx = [keep_idx; selected]; %#ok<AGROW>
        end
        T_work = T_work(keep_idx, :);
    end

    % ---------------------------------------------------------------------
    % 4. Z-score predictors — store params for inverse-transform if needed
    % ---------------------------------------------------------------------
    mu_swp    = mean(T_work.ves_swp,      'omitnan');
    sig_swp   = std(T_work.ves_swp,  0,   'omitnan');
    mu_epvs   = mean(T_work.EPVS_SWP, 'omitnan');
    sig_epvs  = std(T_work.EPVS_SWP, 0, 'omitnan');

    if sig_swp == 0 || sig_epvs == 0
        error('fit_psoct_gam:zeroVariance', ...
              'ves_swp or EPVS_SWP has zero variance. Cannot z-score.');
    end

    T_work.SWP_z      = (T_work.ves_swp      - mu_swp)  / sig_swp;
    T_work.EPVS_SWP_z = (T_work.EPVS_SWP - mu_epvs) / sig_epvs;

    norm_params = struct('mu_swp', mu_swp, 'sig_swp', sig_swp, ...
                         'mu_epvs', mu_epvs, 'sig_epvs', sig_epvs);

    pred_names = {'SWP_z', 'EPVS_SWP_z'};

    % ---------------------------------------------------------------------
    % 5. Fit GAMs
    %    NOTE: fitrgam accepts scalar NumKnots / Order applied to all terms.
    %    Per-predictor knots require separate models (see commented block).
    % ---------------------------------------------------------------------
    if opts.Verbose
        fprintf('[fit_psoct_gam] Fitting GAM for scattering (N=%d voxels)...\n', height(T_work));
    end

    gam_scatter = fitrgam(T_work, 'scattering', ...
        'PredictorNames', pred_names, ...
        'NumKnots',        opts.NumKnots, ...
        'Order',           opts.SplineOrder);

    if opts.Verbose
        fprintf('[fit_psoct_gam] Fitting GAM for retardance...\n');
    end

    gam_retard = fitrgam(T_work, 'retardance', ...
        'PredictorNames', pred_names, ...
        'NumKnots',        opts.NumKnots, ...
        'Order',           opts.SplineOrder);

    % --- Optional: print R-squared equivalents ---
    if opts.Verbose
        yhat_s  = resubPredict(gam_scatter);
        yhat_r  = resubPredict(gam_retard);
        r2_s    = 1 - sum((T_work.scattering - yhat_s).^2) / ...
                      sum((T_work.scattering - mean(T_work.scattering)).^2);
        r2_r    = 1 - sum((T_work.retardance  - yhat_r).^2) / ...
                      sum((T_work.retardance  - mean(T_work.retardance)).^2);
        fprintf('[fit_psoct_gam] Scattering GAM  R² = %.4f\n', r2_s);
        fprintf('[fit_psoct_gam] Retardance  GAM  R² = %.4f\n', r2_r);
    end

    % ---------------------------------------------------------------------
    % 6. Build marginal prediction grids
    %    Each grid varies one predictor while holding the other at its median
    % ---------------------------------------------------------------------
    n_pts        = opts.NumGridPts;
    swp_grid     = linspace(min(T_work.SWP_z), max(T_work.SWP_z), n_pts)';
    epvs_grid    = linspace(min(T_work.EPVS_SWP_z), max(T_work.EPVS_SWP_z), n_pts)';
    swp_med      = median(T_work.SWP_z)      * ones(n_pts, 1);
    epvs_med     = median(T_work.EPVS_SWP_z) * ones(n_pts, 1);

    % Prediction tables — variable names MUST match training predictor names exactly
    T_pred_swp  = array2table([swp_grid,  epvs_med],  'VariableNames', pred_names);
    T_pred_epvs = array2table([swp_med,   epvs_grid], 'VariableNames', pred_names);

    pred_scatter_swp  = predict(gam_scatter, T_pred_swp);
    pred_scatter_epvs = predict(gam_scatter, T_pred_epvs);
    pred_retard_swp   = predict(gam_retard,  T_pred_swp);
    pred_retard_epvs  = predict(gam_retard,  T_pred_epvs);

    % ---------------------------------------------------------------------
    % 7. Plot smooth effects
    % ---------------------------------------------------------------------
    if opts.PlotResults
        plot_smooth_effects(swp_grid, epvs_grid, ...
                            pred_scatter_swp, pred_scatter_epvs, ...
                            pred_retard_swp,  pred_retard_epvs,  ...
                            T_work, norm_params);
    end

    % ---------------------------------------------------------------------
    % 8. Package results
    % ---------------------------------------------------------------------
    results.gam_scatter        = gam_scatter;
    results.gam_retard         = gam_retard;
    results.grid_swp           = swp_grid;
    results.grid_epvs          = epvs_grid;
    results.pred_scatter_swp   = pred_scatter_swp;
    results.pred_scatter_epvs  = pred_scatter_epvs;
    results.pred_retard_swp    = pred_retard_swp;
    results.pred_retard_epvs   = pred_retard_epvs;
    results.T_fit              = T_work;
    results.norm_params        = norm_params;

    if opts.Verbose
        fprintf('[fit_psoct_gam] Done.\n');
    end
end


% =========================================================================
% LOCAL FUNCTION: plot smooth effects
% =========================================================================
function plot_smooth_effects(swp_grid, epvs_grid, ...
                             pred_scatter_swp, pred_scatter_epvs, ...
                             pred_retard_swp,  pred_retard_epvs,  ...
                             T_work, norm_params)

    % Back-transform grids to original scale for x-axis labels
    swp_orig  = swp_grid  * norm_params.sig_swp  + norm_params.mu_swp;
    epvs_orig = epvs_grid * norm_params.sig_epvs + norm_params.mu_epvs;

    fig = figure('Name', 'GAM Smooth Effects — PS-OCT', ...
                 'Position', [80, 80, 1300, 520], ...
                 'Color', 'w');

    colors = struct('swp',  [0.15 0.40 0.75], ...   % blue for vessel SWP
                    'epvs', [0.80 0.20 0.20]);        % red for EPVS SWP

    % --- Helper: rug plot (data density ticks along x-axis) ---
    n_rug = min(2000, height(T_work));
    rug_idx_swp  = randperm(height(T_work), n_rug);
    rug_swp_orig = T_work.ves_swp(rug_idx_swp) ;
    rug_epvs_orig= T_work.EPVS_SWP(rug_idx_swp);

    % ---- Panel 1: Scattering ~ f(vessel SWP) ----------------------------
    ax1 = subplot(2, 2, 1);
    plot(swp_orig, pred_scatter_swp, '-', ...
         'Color', colors.swp, 'LineWidth', 2.5);
    hold on;
    yl = ylim();
    plot(rug_swp_orig, repmat(yl(1), n_rug, 1), '|', ...
         'Color', [colors.swp, 0.25], 'MarkerSize', 4);
    hold off;
    xlabel('Vessel SWP (original scale)');
    ylabel('Scattering coefficient');
    title('Scattering  ~  f(Vessel SWP)');
    subtitle('EPVS SWP held at median', 'FontSize', 8, 'Color', [.4 .4 .4]);
    grid on; box off;

    % ---- Panel 2: Scattering ~ f(EPVS SWP) -----------------------------
    ax2 = subplot(2, 2, 2);
    plot(epvs_orig, pred_scatter_epvs, '-', ...
         'Color', colors.epvs, 'LineWidth', 2.5);
    hold on;
    yl = ylim();
    plot(rug_epvs_orig, repmat(yl(1), n_rug, 1), '|', ...
         'Color', [colors.epvs, 0.25], 'MarkerSize', 4);
    hold off;
    xlabel('EPVS SWP (original scale)');
    ylabel('Scattering coefficient');
    title('Scattering  ~  f(EPVS SWP)');
    subtitle('Vessel SWP held at median', 'FontSize', 8, 'Color', [.4 .4 .4]);
    grid on; box off;

    % ---- Panel 3: Retardance ~ f(vessel SWP) ----------------------------
    ax3 = subplot(2, 2, 3);
    plot(swp_orig, pred_retard_swp, '-', ...
         'Color', colors.swp, 'LineWidth', 2.5);
    hold on;
    yl = ylim();
    plot(rug_swp_orig, repmat(yl(1), n_rug, 1), '|', ...
         'Color', [colors.swp, 0.25], 'MarkerSize', 4);
    hold off;
    xlabel('Vessel SWP (original scale)');
    ylabel('Retardance');
    title('Retardance  ~  f(Vessel SWP)');
    subtitle('EPVS SWP held at median', 'FontSize', 8, 'Color', [.4 .4 .4]);
    grid on; box off;

    % ---- Panel 4: Retardance ~ f(EPVS SWP) -----------------------------
    ax4 = subplot(2, 2, 4);
    plot(epvs_orig, pred_retard_epvs, '-', ...
         'Color', colors.epvs, 'LineWidth', 2.5);
    hold on;
    yl = ylim();
    plot(rug_epvs_orig, repmat(yl(1), n_rug, 1), '|', ...
         'Color', [colors.epvs, 0.25], 'MarkerSize', 4);
    hold off;
    xlabel('EPVS SWP (original scale)');
    ylabel('Retardance');
    title('Retardance  ~  f(EPVS SWP)');
    subtitle('Vessel SWP held at median', 'FontSize', 8, 'Color', [.4 .4 .4]);
    grid on; box off;

    % Link y-axes within each outcome for visual comparison
    linkaxes([ax1, ax2], 'y');
    linkaxes([ax3, ax4], 'y');

    sgtitle('GAM Marginal Smooth Effects on PS-OCT Optical Properties', ...
            'FontSize', 13, 'FontWeight', 'bold');
end