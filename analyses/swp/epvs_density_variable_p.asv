function [subsampled_volume, interpolated_volume] =...
    epvs_density_variable_p(epvs, mask, radius, p)
% Memory-reduced version computing EPVS density at 4x subsampled grid and interpolates

%% Parameters
ncores = 8; % safer default
fprintf('Requested maximum number of processes = %i\n', ncores);
% try to start pool if none exists and fewer than requested workers
try
    poolobj = gcp('nocreate');
    if isempty(poolobj)
        parpool('processes', ncores);
    end
catch
    % proceed without parpool if not available
end

epsilon = 1e-3;

try
    user_mem = memory;
    chunk_size = min(max(2000,floor(user_mem.MaxPossibleArrayBytes/200/8)),...
                     20000);
catch
    chunk_size = 5000;
end

% Dimensions of EPVS volume
dims = size(epvs);

%% EPVS components -> use centroid per component (weight = size)
cc = bwconncomp(epvs, 26);
nComp = cc.NumObjects;

if nComp == 0
    warning('No EPVS voxels found.');
    subsampled_volume = sparse([]);
    interpolated_volume = single([]);
    return;
end

centroids = zeros(nComp,3,'single');
weights = zeros(nComp,1,'single');

for i = 1:nComp
    idxs = cc.PixelIdxList{i};
    [x,y,z] = ind2sub(dims, idxs);
    % centroid (rounded to nearest voxel). Use single precision.
    cent = round(mean([x(:), y(:), z(:)],1));
    centroids(i,:) = single(cent);
    weights(i) = single(numel(idxs));
end

%% Define sampling grid: every 4th voxel in 3D
[xg, yg, zg] = ndgrid(1:4:dims(1), 1:4:dims(2), 1:4:dims(3));
grid_coords = [xg(:), yg(:), zg(:)];
sample_inds = sub2ind(dims, grid_coords(:,1), grid_coords(:,2), grid_coords(:,3));
valid_mask = false(size(sample_inds));
valid_mask(sample_inds) = mask(sample_inds) & ~epvs(sample_inds);
valid_idx = valid_mask;
valid_coords = grid_coords(valid_idx, :);
num_valid = size(valid_coords,1);

if num_valid == 0
    warning('No valid sampled voxels found.');
    subsampled_volume = sparse([]);
    interpolated_volume = single([]);
    return;
end

rows = valid_coords(:,1);
cols = valid_coords(:,2);
deps = valid_coords(:,3);

data = zeros(num_valid,1,'single');

%% Build KD-tree on centroids (double required by KDTreeSearcher)
tree = KDTreeSearcher(double(centroids));

%% Chunking
chunk_start_indices = 1:chunk_size:num_valid;
nChunks = numel(chunk_start_indices);

fprintf('Computing EPVS density at every 4th voxel (%d sampled)...\n', num_valid);
tic;

for chunk_idx = 1:nChunks
    start_idx = chunk_start_indices(chunk_idx);
    stop_idx = min(start_idx + chunk_size - 1, num_valid);
    chunk_inds = start_idx:stop_idx;
    chunk_coords = double(valid_coords(chunk_inds,:)); 

    vals = zeros(numel(chunk_inds), 1, 'single');

    % Use parfor to run per-point rangesearch to avoid storing large cell arrays
    parfor ii = 1:numel(chunk_inds)
        q = chunk_coords(ii,:);
        [idxs, dists] = rangesearch(tree, q, radius);
        idxs = idxs{1};
        dists = dists{1};
        if isempty(idxs)
            vals(ii) = 0;
        else
            w = weights(idxs);
            % ensure single precision for math
            vals(ii) = sum((single(w) ./ (single(dists) + epsilon).^p), 'omitnan');
        end
    end

    data(chunk_inds) = vals;

    if nChunks <= 10 || mod(chunk_idx, ceil(nChunks/10)) == 0
        fprintf('Chunk %d/%d complete (%.1f%%)\n', chunk_idx, nChunks, 100 * chunk_idx / nChunks);
    end
end

fprintf('Subsampled computation done in %.2f seconds.\n', toc);

%% Build subsampled outputs
flat_idx = sub2ind(dims, rows, cols, deps);
% Keep a sparse vector for memory efficiency
subsampled_sparse = sparse(flat_idx, 1, double(data), prod(dims), 1);
% Also create a single 3D array but only fill sampled voxels (single precision)
subsampled_volume = zeros(dims, 'single');
subsampled_volume(flat_idx) = data;

%% Prepare coarse grid for interpolation (coarse coordinates are 1:4:dim)
coarseX = 1:4:dims(1);
coarseY = 1:4:dims(2);
coarseZ = 1:4:dims(3);

% Extract coarse sampled values (matches ndgrid ordering)
Sgrid = subsampled_volume(1:4:end, 1:4:end, 1:4:end);

% Build interpolant with coordinate vectors (avoid huge meshgrids)
F = griddedInterpolant({coarseX, coarseY, coarseZ}, Sgrid, 'linear', 'nearest');

% Evaluate slice-by-slice over Z to avoid huge temporary arrays
interpolated_volume = zeros(dims, 'single');
[X2D, Y2D] = ndgrid(1:dims(1), 1:dims(2)); % reused for each slice (moderate size)
for z = 1:dims(3)
    % F accepts matrix X,Y and scalar Z (broadcasts Z)
    slice = F(X2D, Y2D, single(z));
    interpolated_volume(:,:,z) = single(slice);
    if mod(z, max(1,ceil(dims(3)/10))) == 0
        fprintf('Interpolation slice %d/%d\n', z, dims(3));
    end
end

fprintf('Interpolation complete.\n');

end
