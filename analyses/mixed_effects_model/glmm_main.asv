%% Test linear mixed effects model
%{
The purpose of this script is to analyze the optical properties in the
parenchymal tissue surrounding the EPVS and the vasculature. This covers
just the following cases:
- CAA6 (frontal + occip)
- CAA 17 occipital
- CAA 22 (frontal + occip)
- CAA 25 (frontal + occip)
- CAA 26 (frontal + occip)

Outline:
- IMPORT struct containing optical properties (mus + retardance)
- Linearity assumptions for LMM
- LME model
%}

%% Prepare environment
clc; close all;
addpath(genpath('/projectnb/npbssmic/s/mhyman/oct-caa'));

% Directory for loading seg, mus, ret, mask, epvs
data_dir = '/projectnb/npbssmic/ns/CAA/';
fig_out = '/projectnb/npbssmic/ns/CAA/figures/';

% load the parenchymal optical properties
load(fullfile(data_dir, ...
    'parenchyma_optical_properties_40um_thick_03Nov2025.mat'));

% Flag for testing linearity
lin_test = true;

% Keep same subject index for vessel and EPVS within same subject
flag_subs = true;

%% Iterate distances & count # observations

% Retrieve subject IDs
subs = fieldnames(parench);
% Determine the number of radii from the loaded data
radii = fieldnames(parench.caa6.front);

%%% Calculate number of samples at each radius
% struct to store # samples after iterating subjects
nstruct = struct();
% struct to store # samples on each iteration of radius
nobs = struct();
% Iterate over radii
for ii = 1:numel(radii)
    % Get the current radius
    rad = radii{ii};

    % Counters for ves/epvs at front/occip
    nobs.front.ves_mus = 0; nobs.occip.ves_mus = 0;
    nobs.front.ves_ret = 0; nobs.occip.ves_ret = 0;
    nobs.front.epv_mus = 0; nobs.occip.epv_mus = 0;
    nobs.front.epv_ret = 0; nobs.occip.epv_ret = 0;
    
    % Iterate subjects
    for j = 1:numel(subs)
        % Retrieve the regions (front / occip)
        regs = fieldnames(parench.(subs{j}));
        % Iterate regions
        for k = 1:numel(regs)
            %%% count # observations in vessels and EPVS
            % Vessel mus
            nobs.(regs{k}).ves_mus = numel(nobs.(regs{k}).ves_mus) +...
                numel(parench.(subs{j}).(regs{k}).(rad).outter.ves.pmus);
            % Vessel retardance
            nobs.(regs{k}).ves_ret = numel(nobs.(regs{k}).ves_ret) +...
                numel(parench.(subs{j}).(regs{k}).(rad).outter.ves.pret);
            % EPVS mus
            nobs.(regs{k}).epv_mus = numel(nobs.(regs{k}).epv_mus) +...
                numel(parench.(subs{j}).(regs{k}).(rad).outter.epvs.pmus);
            % EPVS retardance
            nobs.(regs{k}).epv_ret = numel(nobs.(regs{k}).epv_ret) +...
                numel(parench.(subs{j}).(regs{k}).(rad).outter.epvs.pret);
        end
    end
    %%% Store the number of samples for the current radius
    % Frontal
    nstruct.(rad).front.ves_mus = nobs.front.ves_mus;
    nstruct.(rad).front.ves_ret = nobs.front.ves_ret;
    nstruct.(rad).front.epv_mus = nobs.front.epv_mus;
    nstruct.(rad).front.epv_ret = nobs.front.epv_ret;
    % Occipital
    nstruct.(rad).occip.ves_mus = nobs.occip.ves_mus;
    nstruct.(rad).occip.ves_ret = nobs.occip.ves_ret;
    nstruct.(rad).occip.epv_mus = nobs.occip.epv_mus;
    nstruct.(rad).occip.epv_ret = nobs.occip.epv_ret;
end


%% GLME linearity test at each radii
% Define regions (front + occip)
regs = {'front','occip'};
% Iterate over radii
for ii = 1:numel(radii)
    % Iterate over regions
    for j = 1:2        
        % Get the current radius
        rad = radii{ii};
        % Retrieve # vessel and EPVS (same number for both mus and
        % retardance)
        nves = nstruct.(rad).(regs{j}).ves_mus;
        nepv = nstruct.(rad).(regs{j}).epv_mus;

        % Create general linear mixed effects model and check linearity
        [stats, p, ~, ~, ~, ~, ~, ~, ~, ~, ~] =...
            lmm_linearity(lin_test, flag_subs, parench, rad, nves, nepv);

    end
end

%% GLME Linearity after bootstrapping


%% General Linear Mixed Effects Models
% Save to table if desired

%%% Perform LMM Test 1 (same subID for exp/cont within volume)
% Flag for incrementing the subject index just for the tissue volume
flag_subs = true;
[stats1, p1, exp_mus1, exp_ret1, exp_sori1,...
    ctl_mus1, ctl_ret1, ctl_sori1,...
    tbl_mus, tbl_ret, tbl_sori] =...
        lmm_linearity(check_lin, flag_subs, parench, rad, n_ctl, n_exp);
% Export the tables to CSV
fout = fullfile(data_dir,'lmm_test_40um_thick_09Oct2025.xlsx');
writetable(tbl_mus,fout,'Sheet','scattering');
writetable(tbl_ret,fout,'Sheet','retardance');
writetable(tbl_sori,fout,'Sheet','orientation');
