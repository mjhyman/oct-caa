%% Import matlab structs of donuts
%{
Purpose of this script:
- import structs
- wilcoxon signed rank test at each radii
%}

%% Top-level settings
clc; close all;
clearvars -except cd68 gfap lhe

%%% Directories (SCC)
% Input directory
hdir='/projectnb/npbssmic/ns/CAA/histology/';
% Directory to save output figures
figdir = '/projectnb/npbssmic/ns/CAA/histology/figures';

%%% Flags for using histo-matched + z-score
% If false -> use just histogram matching
% If true -> use histogram matching + z-score 
zflag = false;
% Output file
t = datetime('today');
if zflag
    % Wilcoxon
    fname = strcat('histo_iterated_stats_hmatched_zscore_',string(t),'.xlsx');
    stat_sheet = fullfile(hdir,'stats/',fname);
    % GLMM
    fname = strcat('histo_iterated_stats_hmatched_zscore_glmm_',string(t),'.xlsx');
    glmm_sheet = fullfile(hdir,'stats/',fname);
else
    % Wilcoxon
    fname = strcat('histo_iterated_stats_hmatched_',string(t),'.xlsx');
    stat_sheet = fullfile(hdir,'stats/',fname);
    % GLMM
    fname = strcat('histo_iterated_stats_hmatched_glmm_',string(t),'.xlsx');
    glmm_sheet = fullfile(hdir,'stats/',fname);
end

%% Import the stains
if ~exist('lhe','var') || ~exist('gfap','var') || ~exist('cd68','var')
    % Load stains from files
    fprintf('\nLoading CD68\n')
    cd68 = load(fullfile(hdir,"cd68_rings_21-Nov-2025.mat"));
    fprintf('\nLoading GFAP\n')
    gfap = load(fullfile(hdir,"gfap_rings_21-Nov-2025.mat"));
    fprintf('\nLoading LHE\n')
    lhe = load(fullfile(hdir,"lhe_rings_21-Nov-2025.mat"));
end

% Combine all three stains into a single struct for ease of access
stains = struct();
stains.cd68 = cd68.cd68;
stains.gfap = gfap.gfap;
stains.lhe = lhe.lhe;

%% One-sided wilcoxon signed rank test + GLMM

%%% Initialization
stain_names = fieldnames(stains);   % retrieve names of all stains
radius_types = {'rad40', 'rad100'}; % Define the radii sizes that were used
result_rows = {}; % initialize cell array for results table

%%% State which tail to use for test
% Hypothesize myelin rarefaction around EPVS
%   --> (med(EPVS) - med(control)) < 0
%   --> left tailed
tails.cd68 = 'right';
tails.gfap = 'right';
tails.lhe = 'left';
% Set all as both
% tails.cd68 = 'both';
% tails.gfap = 'both';
% tails.lhe = 'both';

for s = 1:numel(stain_names)
    stain = stain_names{s};
    section_struct = stains.(stain); % Array of sections
    %%% Iterate radius type (100um or 40um)
    for rt = 1:numel(radius_types)
        radtype = radius_types{rt};
        % Get all subradius names from the first section
        subrads = fields(section_struct(1).(radtype));
        % Create vector for storing p-values
        p_vector = zeros(numel(subrads),1);
        %%% Iterate radii within type
        for sub = 1:numel(subrads)
            subrad = subrads{sub};
            exp_vec = [];
            ctl_vec = [];
            %%% Iterate sections at specific radius
            for sec = 1:numel(section_struct)
                % If subradius exists & has needed fields
                if isfield(section_struct(sec).(radtype), subrad)
                    rad_struct = section_struct(sec).(radtype).(subrad);
                    % Add section means to exp_vec and ctl_vec
                    if zflag
                        exp_vec(end+1) = rad_struct.exp_mean;
                        ctl_vec(end+1) = rad_struct.ctl_mean;
                    else
                        exp_vec(end+1) = rad_struct.exp_hmatched_mean;
                        ctl_vec(end+1) = rad_struct.ctl_hmatched_mean;
                    end
                end
            end
            
            %%% % Wilcoxon statistical test 
            if ~isempty(exp_vec) && ~isempty(ctl_vec) &&...
                    numel(exp_vec)==numel(ctl_vec)
                
                [p, h, stats] = signrank(exp_vec, ctl_vec,...
                                        'method','approximate',...
                                        'tail',tails.(stain));
                radius_value = sscanf(subrad, 'rad%d');
                med_exp = median(exp_vec);
                med_ctl = median(ctl_vec);
                result_rows(end+1,:) = {stain, radtype, radius_value, ...
                                        med_exp, med_ctl, p,...
                                        stats.signedrank, stats.zval,...
                                        numel(exp_vec)};
                % Add p-value to vector
                p_vector(sub) = p;
            end
        end
        %%% Perform Benjamin & Hochberg false discovery rate
        % print stain name
        fdr = mafdr(p_vector,'BHFDR','true');
        % 
    end
end

stat_tbl = cell2table(result_rows,'VariableNames',...
                    {'Stain', 'RadiusType', 'Radius', 'MedEPVS',...
                    'MedVessel', 'P_Value',...
                    'SignedRankStatistic','Z', 'NumPairs'});

writetable(stat_tbl, stat_sheet);

%% General linear mixed effects model

%%% Initialization
stain_names = fieldnames(stains);   % retrieve names of all stains
radius_types = {'rad40', 'rad100'}; % Define the radii sizes that were used
result_rows = {}; % initialize cell array for results table
% Define the GLMM model with nested brain region
mdl = ['stain_intensity ~ condition + brain_region + (1|subject_id) +' ...
        '(1|subject_id:brain_region)'];
% Define the GLMM model for each brain region separately
% mdl = 'stain_intensity ~ condition + (1|subject_id)';

for s = 1:numel(stain_names)
    stain = stain_names{s};
    section_struct = stains.(stain); % Array of sections
    %%% Iterate radius types (40um or 100um donuts)
    for rt = 1:numel(radius_types)
        radtype = radius_types{rt};
        % Get all subradius names from the first section
        subrads = fields(section_struct(1).(radtype));
        %%% Iterate radii within donuts
        for sub = 1:numel(subrads)
            subrad = subrads{sub};
            % Initialize vectors for storing donut measurements
            exp_vec = [];
            ctl_vec = [];
            % Vector for storing region name
            exp_reg = {};
            ctl_reg = {};
            % Vector for storing subject name
            exp_sub = {};
            ctl_sub = {};
            % Vector for storing section ID
            exp_sec = {};
            ctl_sec = {};

            %%% Iterate sections across subjects
            for sec = 1:numel(section_struct)
                % If subradius exists & has needed fields
                if isfield(section_struct(sec).(radtype), subrad)
                    rad_struct = section_struct(sec).(radtype).(subrad);                   
                    % Add section means to exp_vec and ctl_vec
                    if zflag
                        % Add to respective vector
                        exp_vec = [exp_vec, rad_struct.exp];
                        ctl_vec = [ctl_vec, rad_struct.ctl];
                        % Number elements in vector
                        n_exp = numel(rad_struct.exp);
                        n_ctl = numel(rad_struct.ctl);
                    else
                        % Add to vector
                        exp_vec = [exp_vec, rad_struct.exp_hmatched];
                        ctl_vec = [ctl_vec, rad_struct.ctl_hmatched];
                        % Number elements in vector
                        n_exp = numel(rad_struct.exp_hmatched);
                        n_ctl = numel(rad_struct.ctl_hmatched);
                    end
                    %%% Retrieve region and subject name
                    % Retrieve tissue section ID
                    name = section_struct(sec).baseName;
                    name = strsplit(name,'_');
                    % Retrieve subject ID
                    sub_id = name{1};
                    % Retrieve section ID (1 = front, 7 = occip)
                    sub_reg = name{2};
                    % Add subject ID to array
                    exp_sub_tmp = repmat({sub_id},n_exp,1);
                    ctl_sub_tmp = repmat({sub_id},n_ctl,1);
                    exp_sub = [exp_sub;exp_sub_tmp];
                    ctl_sub = [ctl_sub;ctl_sub_tmp];
                    % Add region to array
                    exp_reg_tmp = repmat({sub_reg},n_exp,1);
                    ctl_reg_tmp = repmat({sub_reg},n_ctl,1);
                    exp_reg = [exp_reg;exp_reg_tmp];
                    ctl_reg = [ctl_reg;ctl_reg_tmp];
                end
            end
            
            %%% GLMM
            if ~isempty(exp_vec) && ~isempty(ctl_vec)
                %%% Create table
                % Concatenate vectors
                stain_intensity = [exp_vec, ctl_vec]';
                brain_region = [exp_reg; ctl_reg];
                subject_id = [exp_sub; ctl_sub];
                condition = [ones(length(exp_vec),1);...
                             zeros(length(ctl_vec),1)];
                % Create table
                tbl = table(stain_intensity, subject_id, brain_region,...
                            condition);
                % Run GLMM
                glme = fitglme(tbl,mdl);
                [~,~,stats_fixed] = fixedEffects(glme);
                % Extract p-value
                p_condition = stats_fixed.pValue(3);
                p_coef = coefTest(glme);
                if p_coef < 0.05
                    pause(1)
                end
                % Test for normal distribution
                exp_normal = lillietest(exp_vec);
                ctl_normal = lillietest(ctl_vec);
                % For table: radius type, mean EPVS, mean ctl
                radius_value = sscanf(subrad, 'rad%d');
                mean_exp = mean(exp_vec,'omitnan');
                mean_ctl = mean(ctl_vec,'omitnan');
                % Add to rows of spreadsheet (revise)
                result_rows(end+1,:) = {stain, radtype, radius_value, ...
                                        mean_exp, mean_ctl, p_condition,...
                                        p_coef, exp_normal, ctl_normal};
            end
        end
    end
end

stat_tbl = cell2table(result_rows, ...
                    'VariableNames', ...
                    {'Stain', 'RadiusType', 'Radius', 'MeanEPVS',...
                    'MeanVessel','Condition_P_Value','Coef_p_value',...
                    'EPVS_normal','CTL_normal'});

writetable(stat_tbl, stat_sheet);