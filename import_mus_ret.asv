%% Import the scattering and retardance volumes for the CAA dataset.
%{
Outline of script:
- import scattering and retardance for each subject
- combine into single data struct
- save struct to: /autofs/cluster/octdata2/users/mjhyman/oct-caa/

Missing:
 - CAA 6 occipital
 - CAA 17 frontal

%}
%% Prepare environment
clear; clc; close all;
% Add top-level directory
d = pwd;


%% Prepare structures
% struct of optical properties (mus & retardance for now)
optical = struct();

% Subject IDs for CAA dataset
sids = {"caa6","caa17","caa22","caa25","caa26"};

% Brain regions
regions = {'occip','front'};

%% Mapping of the filenames
% Top-level directories
base_oct = '/autofs/cluster/octdata2/users/Chao/caa/';
base_omega = '/autofs/space/omega_001/users/caa/';

% Struct to store directory paths
fpaths = struct();

% CAA 6 front:
fpaths.caa6.front.run1 = fullfile(base_oct,'caa_6/frontal/process_run1');
fpaths.caa6.front.run2 = fullfile(base_oct,'caa_6/frontal/process_run2');
fpaths.caa6.front.run3 = fullfile(base_oct,'caa_6/frontal/process_run3');

% CAA 17 occip: 
fpaths.caa17.occip = fullfile(base_oct,'caa_17/occipital/process_run1');

% CAA 22 front:
fpaths.caa22.front.run1 =...
    fullfile(base_oct,'caa_22/processed/20211018/20211018_run1_processed');
fpaths.caa22.front.run2 =...
    fullfile(base_oct,'caa_22/processed/20211018/20211018_run2_processed');
fpaths.caa22.front.run3 =...
    fullfile(base_oct,'caa_22/processed/20211018/20211018_run3_processed');

% CAA 22 occip:
fpaths.caa22.front.run1 = fullfile(base_oct,'/caa_22/processed/20211007');

% CAA 25 front:
fpaths.caa25.front = fullfile(base_omega,'/CAA25_Frontal/Process_caa25_frontal');

% CAA 25 occip:
fpaths.caa25.occip.run1 = fullfile(base_omega,'/CAA25_Occipital/process_caa25_occipital_run1');
fpaths.caa25.occip.run2 = fullfile(base_omega,'/CAA25_Occipital/process_caa25_occipital_run3');
fpaths.caa25.occip.run3 = fullfile(base_omega,'/CAA25_Occipital/process_caa25_occipital_run4');

% CAA 26 front:
fpaths.caa26.front = fullfile(base_omega,'/CAA26_Occipital/Process_caa26_occipital');

% CAA 26 occip:
fpaths.caa26.occip.run1 = fullfile(base_omega,'/CAA26_Frontal/Process_caa26_frontal_run1/');
fpaths.caa26.occip.run2 = fullfile(base_omega,'/CAA26_Frontal/Process_caa26_frontal_run2/');

%}